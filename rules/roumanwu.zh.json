  "searchName": "h3@text",
  "searchResult": "@href",
  "searchCover": "img@src",
  "exploreCategories": [
    {
      "name": "热门",
      "url": "/books?page={{offset:1}}"
    },
    {
      "name": "最新更新",
      "url": "/home"
    }
  ],
  "exploreList": ".site-collection .site-comic-grid a.site-comic, .site-home > .site-home-section:nth-child(3) a.site-comic",
  "exploreName": "h3@text",
  "exploreResult": "@href",
  "exploreCover": "img@src",
  "detailTitle": ".site-book-info h1@text",
  "detailCover": "img.site-detail-cover@src",
  "detailAuthor": "dl.site-book-data dd:nth-child(2)@text",
  "detailIntro": ".site-book-synopsis@text",
  "chapterList": "a.site-chapter-link",
  "chapterName": "span@title",
  "chapterUrl": "@href",
  "chapterReverse": true,
  "pageList": "img@src",
  "description": "肉漫屋官网公开游客目录、名称搜索和已公开章节。通过官网页图列表按顺序读取，并恢复站点分块图片格式。"
}
