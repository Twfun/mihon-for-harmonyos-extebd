{
  "schema": "kazumi-comic-v1",
  "id": "keiyoushi.zh.jcomic",
  "name": "JComic",
  "lang": "zh",
  "version": "1.0.0",
  "versionCode": 1,
  "baseURL": "https://jcomic.net",
  "contentFormat": "jcomic-public",
  "searchURL": "/search/@keyword/@page",
  "searchList": ".container .col-lg-4",
  "searchName": ".comic-title@text",
  "searchResult": "@xpath:./a[1]/@href",
  "exploreCategories": [
    {
      "name": "随机",
      "url": "/cat/%E9%9A%A8%E6%A9%9F/@page"
    },
    {
      "name": "最近更新",
      "url": "/cat/%E6%9C%80%E8%BF%91%E6%9B%B4%E6%96%B0/@page"
    }
  ],
  "exploreList": ".container .col-lg-4",
  "exploreName": ".comic-title@text",
  "exploreResult": "@xpath:./a[1]/@href",
  "detailTitle": "h1@text",
  "detailAuthor": "a[href^=\"/author/\"] button@text",
  "chapterList": "div.row.col-md-6 a[href^=\"/page/\"]",
  "chapterName": "@text",
  "chapterUrl": "@href",
  "pageList": "img@src",
  "description": "JComic 官网页面自动签发游客会话，供公开发现、搜索和按需加载章图。短效页图仅从官网图床读取。"
}
