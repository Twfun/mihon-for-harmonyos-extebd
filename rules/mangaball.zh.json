{
  "schema": "kazumi-comic-v1",
  "id": "keiyoushi.zh.mangaball",
  "name": "Manga Ball",
  "lang": "zh",
  "version": "1.0.1",
  "versionCode": 2,
  "baseURL": "https://mangaball.com",
  "contentFormat": "mangaball-public",
  "headers": {
    "X-Requested-With": "XMLHttpRequest"
  },
  "searchURL": "/api/v1/title/search-advanced?page=@page&limit=24&keyword=@keyword&tag_mode=AND&adult_mode=all&chapterLanguage=zh%2Czh-cn%2Czh-hk%2Czh-mo%2Czh-sg%2Czh-tw%2Ccn",
  "searchList": "$.data[*]",
  "searchName": "$.name",
  "searchResult": "@tmpl:/api/v1/title/detail/{{$.id}}",
  "searchCover": "$.image.cdn_mangadex||$.image.file||$.image.cdn_mangaupdate||$.image.cdn_mangaupdates",
  "exploreCategories": [
    {
      "name": "熱門中文",
      "url": "/api/v1/title/search-advanced?page=@page&limit=24&sort_by=views&sort_order=desc&tag_mode=AND&adult_mode=all&chapterLanguage=zh%2Czh-cn%2Czh-hk%2Czh-mo%2Czh-sg%2Czh-tw%2Ccn"
    },
    {
      "name": "最新中文",
      "url": "/api/v1/title/search-advanced?page=@page&limit=24&sort_by=lastupdate&sort_order=desc&tag_mode=AND&adult_mode=all&chapterLanguage=zh%2Czh-cn%2Czh-hk%2Czh-mo%2Czh-sg%2Czh-tw%2Ccn"
    }
  ],
  "detailTitle": "$.data.name",
  "detailAuthor": "$.data.author[*].name",
  "detailIntro": "$.data.description[*]",
  "detailGenre": "$.data.tags[*].name",
  "detailStatus": "$.data.status",
  "detailCover": "$.data.image.cdn_mangadex||$.data.image.file||$.data.image.cdn_mangaupdate||$.data.image.cdn_mangaupdates",
  "tocUrl": "@tmpl:/api/v1/chapter/chapter-listing-by-title-id,{\"method\":\"POST\",\"headers\":{\"Content-Type\":\"application/json\"},\"body\":\"{\\\"title_id\\\":\\\"{{$.data.id}}\\\"}\"}",
  "chapterList": "$.data[*]",
  "chapterName": "$.name",
  "chapterUrl": "@tmpl:/api/v1/chapter-detail?chapter_id={{$.id}}",
  "pageList": "$.data.chapter.pages[*]",
  "description": "官方公開中文目錄，僅顯示公開發布的各種中文語碼章節。目錄使用同站只讀 POST。目前支援已實測的 chikorita.red-and-blue.net 公開頁圖。不含瀏覽次數回報，超過現有響應上限的目錄待支持。 官方明列的封面鏡像優先，原相簿封面主機在抽樣中返回 HTTP 403。"
}
