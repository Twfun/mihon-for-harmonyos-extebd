{
  "schema": "kazumi-comic-v1",
  "id": "keiyoushi.zh.boylove",
  "name": "香香腐宅",
  "version": "1.0.0",
  "versionCode": 1,
  "lang": "zh",
  "baseURL": "https://boylove.cc",
  "contentFormat": "boylove-public",
  "searchURL": "/home/api/searchk?keyword=@keyword&type=1&pageNo=@page",
  "exploreCategories": [
    {"name": "人气", "url": "/home/api/getpage/tp/1-topestmh-{{offset:1}}"},
    {"name": "最近更新", "url": "/home/Api/getDailyUpdate.html?widx=4&page={{offset:1}}&limit=10"}
  ],
  "searchList": "$.items[*]",
  "searchName": "$.title",
  "searchResult": "@tmpl:/home/book/index/id/{{$.id}}",
  "searchCover": "$.image",
  "searchAuthor": "$.auther",
  "exploreList": "$.items[*]",
  "exploreName": "$.title",
  "exploreResult": "@tmpl:/home/book/index/id/{{$.id}}",
  "exploreCover": "$.image",
  "detailTitle": ".stui-content__detail h1@text",
  "detailAuthor": "class.stui-content__detail@p.data a[href*='/home/index/searchkw/']@index.0@text",
  "detailCover": ".stui-content__thumb a@data-original",
  "detailIntro": ".stui-content__detail p.desc .detail-text@text",
  "detailStatus": "class.stui-content__detail@p.data@index.0@text",
  "chapterList": "$.result.list[*]",
  "chapterName": "$.title",
  "chapterUrl": "@tmpl:/home/book/capter/id/{{$.id}}",
  "pageList": "section.reader-cartoon-chapter .reader-cartoon-image[data-page] img@data-original",
  "description": "使用香香腐宅官网访客入口，读取公开目录与访客可读章节，保留需授权章节的标记。"
}
