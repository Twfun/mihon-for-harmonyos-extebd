{
  "schema": "kazumi-comic-v1",
  "id": "keiyoushi.zh-tw.pixiv",
  "name": "Pixiv（公開漫畫）",
  "version": "1.0.0",
  "versionCode": 1,
  "lang": "zh-tw",
  "baseURL": "https://www.pixiv.net",
  "headers": {
    "Accept": "application/json",
    "Referer": "https://www.pixiv.net/"
  },
  "searchURL": "/ajax/search/artworks/@keyword?word=@keyword&order=date_d&mode=safe&p=@page&s_mode=s_tag&type=manga&lang=zh-tw",
  "searchList": "$.body.illustManga.data[?(@.illustType == 1)][?(@.xRestrict == 0)]",
  "searchName": "$.title",
  "searchResult": "@tmpl:/ajax/illust/{{$.id}}?lang=zh-tw",
  "searchCover": "$.url",
  "searchAuthor": "$.userName",
  "exploreCategories": [
    {
      "name": "最新公開漫畫",
      "url": "/ajax/search/artworks/%E6%BC%AB%E7%95%AB?word=%E6%BC%AB%E7%95%AB&order=date_d&mode=safe&p=@page&s_mode=s_tag&type=manga&lang=zh-tw"
    }
  ],
  "detailTitle": "$.body.title",
  "detailAuthor": "$.body.userName",
  "detailCover": "$.body.urls.regular",
  "chapterList": "$.body",
  "chapterName": "$.title",
  "chapterUrl": "@tmpl:/ajax/illust/{{$.id}}/pages?lang=zh-tw",
  "chapterTime": "$.createDate",
  "pageList": "$.body[*].urls.original",
  "description": "繁體中文介面的公開單篇漫畫。系列合併、作者檢索和限帳號內容待支援。"
}
