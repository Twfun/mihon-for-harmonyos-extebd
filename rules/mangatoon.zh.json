{
  "schema": "kazumi-comic-v1",
  "id": "keiyoushi.zh.mangatoon",
  "name": "MangaToon (Limited)",
  "version": "1.0.0",
  "versionCode": 1,
  "lang": "zh",
  "baseURL": "https://sg.mangatoon.mobi",
  "contentFormat": "mangatoon-public",
  "searchURL": "/api/content/list?word=@keyword",
  "exploreCategories": [
    {"name": "热门", "url": "/api/content/list?type=1&order=hot&page=@page"},
    {"name": "最近更新", "url": "/api/content/list?type=1&order=new&page=@page"}
  ],
  "searchList": "$.data[*]",
  "searchName": "$.title",
  "searchResult": "@tmpl:/api/content/detail?id={{$.id}}",
  "searchCover": "$.image_url",
  "searchAuthor": "$.author.name",
  "exploreList": "$.data[*]",
  "exploreName": "$.title",
  "exploreResult": "@tmpl:/api/content/detail?id={{$.id}}",
  "exploreCover": "$.image_url",
  "detailTitle": "$.data.title",
  "detailAuthor": "$.data.author.name",
  "detailIntro": "$.data.content_description",
  "detailCover": "$.data.image_url",
  "detailTags": "$.data.tags[*].name",
  "detailStatus": "$.data.publicationStatus",
  "tocUrl": "@tmpl:/api/content/episodes?id={{$.data.id}}",
  "chapterList": "$.data[*]",
  "chapterName": "$.title",
  "chapterUrl": "@tmpl:/api/cartoons/pictures?id={{$.id}}",
  "pageList": "$.data[*].url",
  "description": "沿用漫画堂官方中文 H5，免账号浏览和搜索。只列出游客已开放的免费章，阅读时再次核验作品、章节和免费状态，使用官方 H5 水印图片。"
}
