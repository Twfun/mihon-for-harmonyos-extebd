  "chapterList": "ol.list-ep li.normal_ep a.js-episode-link[onclick]",
  "chapterName": ".cell-title strong@text",
  "chapterUrl": "@toomics-free-href",
  "chapterTime": ".cell-time time@text",
  "pageList": "div[id^=\"load_image_\"] img[data-src]@data-src",
  "description": "官方简体中文安全模式目录及明确开放给游客的免费章。搜索待移植。"
