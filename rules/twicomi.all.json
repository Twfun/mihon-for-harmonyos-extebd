{
  "schema": "kazumi-comic-v1",
  "id": "keiyoushi.all.twicomi",
  "name": "Twicomi（公開單帖）",
  "version": "1.0.0",
  "versionCode": 1,
  "lang": "all",
  "baseURL": "https://api.twicomi.com",
  "searchURL": "/api/v2/manga/list?query=@keyword&page_no=@page&page_limit=12",
  "searchList": "$.response.manga_list[*]",
  "searchName": "$.tweet.tweet_text||$.author.name",
  "searchAuthor": "$.author.name",
  "searchResult": "@tmpl:/api/v2/author/manga/init?screen_name={{$.author.screen_name}}&tweet_id={{$.tweet.tweet_id}}&page_limit=1",
  "searchCover": "$.tweet.attach_image_urls[0]",
  "exploreCategories": [
    {
      "name": "精選漫畫帖",
      "url": "/api/v2/manga/featured/list?page_no=@page&page_limit=24"
    },
    {
      "name": "最新漫畫帖",
      "url": "/api/v2/manga/list?order_by=create_time&page_no=@page&page_limit=24"
    }
  ],
  "detailTitle": "$.response.manga.manga_list[0].tweet.tweet_text||$.response.author.name",
  "detailAuthor": "$.response.author.name",
  "detailIntro": "$.response.manga.manga_list[0].tweet.tweet_text",
  "detailCover": "$.response.manga.manga_list[0].tweet.attach_image_urls[0]",
  "chapterList": "$.response.manga.manga_list[*]",
  "chapterName": "@tmpl:Tweet {{$.tweet.tweet_id}}",
  "chapterUrl": "@tmpl:/api/v2/author/manga/init?screen_name={{$.author.screen_name}}&tweet_id={{$.tweet.tweet_id}}&page_limit=1",
  "pageList": "$.response.manga.manga_list[0].tweet.attach_image_urls[*]",
  "description": "官方無帳號公開單帖漫畫：精選、最新、文字搜尋、單帖詳情及完整附件圖片。透過官網JS實際使用的單帖JSON接口，不執行Nuxt腳本。作者聚合章目與作者搜尋模式待移植；官方驗證或不可用回應無頁圖時明確失敗。"
}
