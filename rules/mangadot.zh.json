{
  "schema": "kazumi-comic-v1",
  "id": "keiyoushi.zh.mangadot",
  "name": "MangaDot（中文）",
  "version": "1.0.0",
  "versionCode": 1,
  "lang": "zh",
  "baseURL": "https://mangadot.net",
  "contentFormat": "mangadot-public",
  "headers": {
    "X-Requested-With": "XMLHttpRequest"
  },
  "searchURL": "/api/search?lang=zh&limit=56&page=@page&search=@keyword",
  "exploreCategories": [
    {
      "name": "最新中文更新",
      "url": "/api/search?lang=zh&limit=56&page=@page&sortBy=latest&sortOrder=desc"
    }
  ],
  "searchList": "$.manga_list[*]",
  "searchName": "$.title",
  "searchResult": "@tmpl:/manga/{{$.id}}.data?_routes=pages%2FMangaDetailPage",
  "searchCover": "$.photo",
  "detailTitle": "$.title",
  "detailAuthor": "$.authors",
  "detailIntro": "$.description",
  "detailCover": "$.photo",
  "detailGenre": "$.genres[*]",
  "detailStatus": "$.status",
  "tocUrl": "@tmpl:/api/manga/{{$.id}}/chapters/list?lang=zh",
  "chapterList": "$[*]",
  "chapterName": "$.chapter_title",
  "chapterUrl": "@tmpl:/api/uploads/{{$.id}}/images",
  "pageList": "$.images[*].url",
  "description": "免账号公开中文目录，沿用原版 zh 语码。章目与阅读严格核对语种、作品、连载章节及已公开页图；卷模式待移植。"
}
