  "detailCover": "@css:article section img@src",
  "detailIntro": "@css:article header span@text",
  "chapterList": "@css:article",
  "chapterName": "@css:header h1@text",
  "chapterUrl": "@css:a[href$=\"/1\"]@href",
  "pageList": "@css:[wire:name=\"pages::post-reader\"]",
