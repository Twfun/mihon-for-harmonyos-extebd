{
  "schema": "kazumi-comic-v1",
  "id": "keiyoushi.zh.toonlook",
  "name": "ToonLook（中文）",
  "lang": "zh",
  "baseURL": "https://toonlook.com",
  "version": "1.0.0",
  "versionCode": 1,
  "contentFormat": "toonlook-public",
  "searchURL": "/<,page/@page/>?s=@keyword",
  "searchList": "@css:.manga-item",
  "searchName": "@css:a.manga-item__link@text",
  "searchResult": "@css:a.manga-item__link@href",
  "searchCover": "@css:img.manga-item__img-inner@src",
  "exploreCategories": [
    {
      "name": "熱門",
      "url": "/manhwa/<,page/@page/>?sortby=daily_top"
    },
    {
      "name": "最新",
      "url": "/manhwa/<,page/@page/>?sortby=latest"
    }
  ],
  "detailTitle": "@css:.manga-titles h1@text",
  "detailCover": "@css:img[src*=\"/img/cover/\"]@src",
  "detailIntro": "@css:.manga-desc__content@text",
  "detailAuthor": "@css:div.items-start a[rel=tag][href*=\"/manga-author/\"] > span:first-child@text",
  "detailStatus": "@css:.manga-status[data-status]@data-status",
  "chapterList": "@css:a.chapter-item[data-id][data-langs]",
  "chapterName": "@css:.chapter-item__name@text",
  "chapterUrl": "@href",
  "pageList": "@css:script",
  "description": "沿用 ToonLook 官網中文語種。只顯示官方標記中文的漫畫、目錄和標記語種一致的訪客頁圖。"
}
