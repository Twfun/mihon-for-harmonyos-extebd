      "url": "/category/order/addtime/page/@page"
    }
  ],
  "detailTitle": "#mintWorkTitle@text",
  "detailCover": "#mintWorkCover@src",
  "detailIntro": "#mintIntroPanel > div@text",
  "detailStatus": ".mint-work-info .mint-tag@text",
  "chapterList": ".mint-chapter-grid a[data-chapter-id][href^='/comic/']",
  "chapterName": "@text",
  "chapterUrl": "@href",
  "contentUrl": "noscript a[href^='https://reader.hqread.cc/r/']@href",
