{
  "schema": "kazumi-comic-v1",
  "id": "keiyoushi.all.cinblue",
  "name": "Cin.blue",
  "version": "1.0.0",
  "versionCode": 1,
  "lang": "all",
  "baseURL": "https://cin.blue",
  "allowedHosts": [
    "same.yui.pw"
  ],
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "Referer": "https://cin.blue/",
    "Origin": "https://cin.blue"
  },
  "searchURL": "https://same.yui.pw/api/v6/search/@keyword/@page/popular-today",
  "searchList": "$.result[*]",
  "searchName": "$.title.pretty || $.title.english || $.title.japanese",
  "searchResult": "@tmpl:https://same.yui.pw/api/v6/book/{{$.id}}",
  "searchCover": "$.cover.t",
  "exploreCategories": [
    {
      "name": "Popular Today",
      "url": "https://same.yui.pw/api/v6/search/-/@page/popular-today"
    },
    {
      "name": "Latest",
      "url": "https://same.yui.pw/api/v6/search/-/@page/date"
    }
  ],
  "exploreList": "$.result[*]",
  "exploreName": "$.title.pretty || $.title.english || $.title.japanese",
  "exploreResult": "@tmpl:https://same.yui.pw/api/v6/book/{{$.id}}",
  "exploreCover": "$.cover.t",
  "detailTitle": "$.title.english || $.title.japanese || $.title.pretty",
  "detailCover": "$.cover.t || $.images.cover.t",
  "detailTags": "$.tags[*].name",
  "chapterList": "$",
  "chapterName": "$.title.pretty || $.title.english || $.title.japanese",
  "chapterUrl": "@tmpl:https://same.yui.pw/api/v6/book/{{$.id}}",
  "pageList": "$.images.pages[*].t",
  "description": "Cin.blue 全语种公共目录",
  "iconUrl": "https://cdn.jsdelivr.net/gh/keiyoushi/extensions-source@main/src/all/cinblue/res/mipmap-xhdpi/ic_launcher.png"
}
