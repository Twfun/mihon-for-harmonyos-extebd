{
  "schema": "kazumi-comic-v1",
  "id": "keiyoushi.all.grabberzone",
  "name": "Grabber Zone",
  "version": "1.0.0",
  "versionCode": 1,
  "lang": "all",
  "baseURL": "https://grabber.zone",
  "searchURL": "/?s=@keyword&post_type=wp-manga",
  "searchList": ".c-tabs-item__content",
  "searchName": ".post-title a@text",
  "searchResult": ".post-title a@href",
  "searchCover": ".tab-thumb img@data-src || .tab-thumb img@src",
  "exploreCategories": [
    {
      "name": "全部漫画",
      "url": "/comics/page/@page/"
    }
  ],
  "exploreList": ".page-item-detail.manga",
  "exploreName": ".post-title a@text",
  "exploreResult": ".post-title a@href",
  "exploreCover": ".item-thumb img@data-src || .item-thumb img@src",
  "detailTitle": ".post-title h1@text",
  "detailCover": ".summary_image img@data-src || .summary_image img@src",
  "detailIntro": ".description-summary@text",
  "chapterList": "li.wp-manga-chapter",
  "chapterName": "@css:a + a@text || @css:a@text",
  "chapterUrl": "@tmpl:{{@css:.chapter-thumbnail a@href || @css:a@href}}?style=list",
  "chapterTime": ".chapter-release-date@text",
  "chapterReverse": true,
  "pageList": ".reading-content .page-break img@data-src || .reading-content .page-break img@src",
  "description": "Grabber Zone 多语种公共漫画目录"
}
