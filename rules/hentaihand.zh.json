{
  "schema": "kazumi-comic-v1",
  "id": "keiyoushi.zh.hentaihand",
  "name": "HentaiHand",
  "version": "1.0.0",
  "versionCode": 1,
  "lang": "zh",
  "baseURL": "https://hentaihand.com",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "Accept": "application/json",
    "X-Requested-With": "XMLHttpRequest"
  },
  "searchURL": "https://hentaihand.com/api/comics?page=@page&sort=popularity&order=desc&duration=all&q=@keyword&languages%5B-1%5D=1&languages%5B-2%5D=50",
  "searchList": "$.data[*]",
  "searchName": "$.title",
  "searchResult": "@tmpl:https://hentaihand.com/api/comics/{{$.slug}}",
  "searchCover": "$.image_url",
  "exploreCategories": [
    {
      "name": "热门",
      "url": "https://hentaihand.com/api/comics?page=@page&sort=popularity&order=desc&duration=all&languages%5B-1%5D=1&languages%5B-2%5D=50"
    },
    {
      "name": "最新",
      "url": "https://hentaihand.com/api/comics?page=@page&sort=uploaded_at&order=desc&duration=all&languages%5B-1%5D=1&languages%5B-2%5D=50"
    }
  ],
  "exploreList": "$.data[*]",
  "exploreName": "$.title",
  "exploreResult": "@tmpl:https://hentaihand.com/api/comics/{{$.slug}}",
  "exploreCover": "$.image_url",
  "detailTitle": "$.title",
  "detailCover": "$.image_url",
  "detailAuthor": "$.artists[0].name || $.authors[0].name",
  "detailIntro": "$.description",
  "detailTags": "$.tags[*].name",
  "chapterList": "$",
  "chapterName": "$.title",
  "chapterUrl": "@tmpl:https://hentaihand.com/api/comics/{{$.slug}}/images",
  "pageList": "$.images[*].source_url",
  "description": "中文汉化同人志、单行本与全彩短篇资料库",
  "iconUrl": "https://cdn.jsdelivr.net/gh/keiyoushi/extensions-source@main/src/all/hentaihand/res/mipmap-xhdpi/ic_launcher.png"
}
